# CareerPulse Analysis Backend Environment Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# PostgreSQL Connection URL
# On Render: Use the Internal Database URL (or External Database URL for external tools)
# Format: postgresql://username:password@hostname:5432/database_name
DATABASE_URL=postgresql://careerpulse_user:password123@dpg-xxxxxx-a:5432/careerpulse_db

# Sentence Transformer Model (lightweight & fast for cloud CPU instances)
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
